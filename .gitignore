*.DS_Store*

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron
.env

# Local lab / batch run artifacts (not course materials)
output/
my_first_plot.png
lab2_sf_income_by_race.png
lab2_sf_homeownership_by_race.png
data/in_co_renters.csv
data/in_co_renters.rds
data/cache/

# Agent web research scratch (promote manually if needed)
search-artifacts/

# Local mirrors of official UCB DataHub repos + raw issue dumps (see website/maintainer/mirrors/README.md)
website/maintainer/mirrors/*
!website/maintainer/mirrors/README.md

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

/.quarto/

# Patch reject files and backups (batch runner) — keep out of code/
*.rej
*.rej.orig
*.orig
website/maintainer/patches/*.rej

# Staff-only maintainer output - never publish to the public site.
# Ignore the whole rendered maintainer dir: notes.qmd is draft:true, but
# lab1-merge-proposal.md and run_all_labs.R render/copy here too and are not drafts.
docs/maintainer-notes.html
docs/maintainer/

# Quarto copies these website/ files into docs/ as "resources" - not site pages.
docs/_quarto.yml
docs/SOC-N100-website-for-maintainers.Rproj
